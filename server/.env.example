# 复制为 server/.env 后填写 (server/.env 已 gitignore, 不进仓库)
# 内置 MiniMax 文本模型的服务器密钥。留空时:
# - 客户端仍显示内置 MiniMax 并可选中/测试;
# - 实际请求会返回明确报错「服务器未配置 MINIMAX_API_KEY」。
# 填写后重启服务器生效。
MINIMAX_API_KEY=

# Public deployment only: exact origins, comma-separated; no trailing slash.
# Nginx injects a private token (not sent to browsers). Configure both or neither.
PINAX_PUBLIC_ORIGINS=
PINAX_PROXY_SECRET=

# StoryAgent: starts on loopback when a server text credential is available.
# Install adapter dependencies: npm ci --prefix adapters/pinax-adapter (Node 22).
# Set to 0 to keep only the existing advisor/native narrative loop.
PINAX_STORYAGENT_ENABLED=1
# Fixed server-owned runtime; never supplied by a browser request.
PINAX_ADAPTER_ENDPOINT=http://127.0.0.1:8451
