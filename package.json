{
  "name": "pinax",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop pinax",
    "deploy:build": "npm ci && npm run build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "lint": "eslint src --ext .js,.vue",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run verify:full",
    "verify:contract": "vitest run",
    "verify:post": "vite build && git diff --check",
    "verify:full": "vitest run --exclude=src/__tests__/visual-verification.test.js && vite build && git diff --check && vitepress build docs/src && vitest run src/__tests__/visual-verification.test.js",
    "docs:dev": "vitepress dev docs/src",
    "docs:build": "vitepress build docs/src",
    "docs:preview": "vitepress preview docs/src",
    "audit:ui": "node scripts/ui-audit.mjs",
    "smoke:structured-settings": "node scripts/structured-settings-gate.mjs",
    "eval:narrative-context": "vite-node scripts/narrative-context-eval.mjs",
    "report:narrative-production": "vite-node scripts/narrative-production-report.mjs",
    "smoke:narrative-production": "node scripts/narrative-production-smoke.mjs",
    "smoke:online-narrative": "node scripts/online-narrative-smoke.mjs"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "axios": "^1.6.0",
    "comlink": "^4.4.2",
    "cors": "^2.8.5",
    "d3-hierarchy": "^3.1.2",
    "delaunator": "^5.1.0",
    "dompurify": "^3.4.7",
    "express": "^4.18.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.0.3",
    "mem0ai": "^3.0.3",
    "pinia": "^2.1.0",
    "turndown": "^7.2.4",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.0.0",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "vite": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.0.0",
    "vitest-axe": "^0.1.0"
  }
}
